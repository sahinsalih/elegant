{
  "name": "elegant",
  "productName": "Elegant",
  "version": "1.0.2",
  "private": true,
  "description": "A desktop app for software projects, notes, and tasks",
  "license": "MIT",
  "homepage": "https://github.com/sahinsalih/elegant",
  "repository": {
    "type": "git",
    "url": "https://github.com/sahinsalih/elegant.git"
  },
  "bugs": {
    "url": "https://github.com/sahinsalih/elegant/issues"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tests/store.test.js",
    "dist": "electron-builder --win nsis",
    "release": "electron-builder --win nsis --publish always"
  },
  "build": {
    "appId": "com.salihsahin.elegant",
    "productName": "Elegant",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "shortcutName": "Elegant",
      "uninstallDisplayName": "Elegant"
    }
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.15.3"
  }
}
